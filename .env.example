# ============================================================================
# .env.example
# Plantilla de variables de entorno. Copia este archivo como ".env" y rellena
# tus valores reales. El archivo ".env" NUNCA debe subirse a git (ver .gitignore).
# ============================================================================

# API key de tu cuenta de Weights & Biases (https://wandb.ai/authorize)
WANDB_API_KEY=tu_api_key_aqui

# Prefijo de proyecto W&B. El script añade "-Base" y "-Augmented" para que
# cada experimento reporte a un proyecto W&B independiente.
WANDB_PROJECT=YOLOv12-VisDrone

# Entidad (usuario u organización) de W&B. Déjalo vacío para usar la entidad
# por defecto de tu cuenta.
WANDB_ENTITY=
